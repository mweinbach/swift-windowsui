      "plannedCaseId": "canonical-v1",
      "text": "\ufeff%YAML 1.2\r\n---\r\n# Synthetic comment: caf\u00e9\r\n\r\nversion: 1\r\nmodules:\r\n  # First name follows.\r\n  - name: _Overlay\r\n\r\n  - name: Overlay2\r\n# Final comment.\r\n",
