    {
      "id": "canonical-lf",
      "plannedCaseId": "canonical-v1",
      "text": "version: 1\nmodules:\n  - name: _Overlay\n",
      "expectedStatus": "parsed-canonical-v1",
      "expectedNames": [
        "_Overlay"
      ],
      "explanation": "The canonical two-space block item uses LF and a final newline."
    },
    {
      "id": "canonical-no-final-newline",
      "plannedCaseId": "canonical-v1",
      "text": "version: 1\nmodules:\n  - name: _Overlay",
