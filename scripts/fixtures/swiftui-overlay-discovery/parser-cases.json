      "plannedCaseId": "canonical-v1",
      "text": "version: 1\r\nmodules:\r\n  - name: _Overlay\r\n",
      "expectedStatus": "parsed-canonical-v1",
      "expectedNames": [
        "_Overlay"
      ],
      "explanation": "CRLF line endings preserve the same name occurrence."
